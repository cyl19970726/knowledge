{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/contracts/**/*.ts",
    "packages/knowledge/**/*.ts",
    "packages/knowledge-contracts/**/*.ts",
    "packages/knowledge-client/**/*.ts",
    "packages/knowledge-application/**/*.ts",
    "packages/adapters/knowledge-service/**/*.ts",
    "packages/adapters/knowledge-document/**/*.ts",
    "apps/knowledge-api/**/*.ts",
    "apps/knowledge-worker/**/*.ts",
    "apps/knowledge-web/**/*.ts",
    "apps/knowledge-web/**/*.tsx",
    "scripts/runtime/**/*.ts"
  ],
  "exclude": [
    "packages/knowledge/test/daily-research.test.ts",
    "packages/knowledge/test/daily-report-archive.test.ts"
  ]
}
