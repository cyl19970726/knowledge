{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "../../",
    "outDir": "dist/types",
    "types": ["node"],
    "esModuleInterop": true
  },
  "files": [
    "src/store.ts",
    "src/types.ts",
    "src/utils.ts",
    "src/wiki-page.ts",
    "src/wiki-lexical-query.ts",
    "src/writer-authority.ts",
    "src/migrations.ts"
  ]
}
